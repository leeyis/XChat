{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-editor",
  "description": "Narrow permissions for the screenshot editor window",
  "windows": ["capture-editor"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-get-pending-capture",
    "allow-finish-capture-editor",
    "allow-save-capture-editor",
    "allow-copy-capture-editor",
    "allow-cancel-capture-editor",
    "allow-pin-capture"
  ]
}
