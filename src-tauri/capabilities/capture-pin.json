{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-pin",
  "description": "Narrow permissions for the pinned screenshot window",
  "windows": [
    "capture-pin-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "core:window:allow-set-shadow",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "allow-get-pending-capture",
    "allow-pin-capture",
    "allow-copy-pinned-capture",
    "allow-save-pinned-capture",
    "allow-resize-pinned-capture",
    "allow-set-pinned-capture-shadow",
    "allow-close-pinned-capture",
    "allow-read-capture-clipboard",
    "allow-write-capture-text",
    "allow-update-pinned-capture",
    "allow-finish-capture-editor",
    "allow-save-capture-editor",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-position"
  ]
}
