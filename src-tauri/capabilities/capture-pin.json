{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-pin",
  "description": "Narrow permissions for the pinned screenshot window",
  "windows": ["capture-pin"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-pending-capture",
    "allow-copy-pinned-capture",
    "allow-save-pinned-capture",
    "allow-resize-pinned-capture",
    "allow-set-pinned-capture-shadow",
    "allow-close-pinned-capture"
  ]
}
