{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:path:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-stat",
    "dialog:default",
    "sql:default",
    "log:default",
    "shell:default",
    "allow-show-notification",
    "allow-clear-notification",
    "allow-get-notifications-enabled",
    "allow-set-notifications-enabled",
    "allow-start-tray-flash",
    "allow-stop-tray-flash",
    "allow-open-saf-picker",
    "allow-get-my-name",
    "allow-get-my-id",
    "allow-update-my-name",
    "allow-get-peers",
    "allow-send-message",
    "allow-get-chat-history",
    "allow-get-chat-history-with-offset",
    "allow-send-file",
    "allow-get-settings",
    "allow-update-settings",
    "allow-update-workspace-preference",
    "allow-get-theme-list",
    "allow-get-theme-css",
    "allow-save-current-theme",
    "allow-get-current-theme",
    "allow-accept-file",
    "allow-get-default-download-path",
    "allow-request-storage-permission",
    "allow-save-file-message",
    "allow-read-clipboard-files",
    "allow-delete-messages",
		"allow-clear-chat-history",
		"allow-delete-user-complete",
		"allow-get-custom-peers",
		"allow-add-custom-peer",
		"allow-remove-custom-peer",
		"allow-request-file",
		"allow-get-language",
		"allow-set-language",
		"allow-request-permission-on-android",
    "allow-get-workspace-snapshot",
    "allow-create-group",
    "allow-update-group",
    "allow-recall-conversation-message",
    "allow-forward-conversation-message",
    "allow-save-conversation-file-as",
    "allow-pick-workspace-directory",
    "allow-copy-file-message-content",
    "allow-send-conversation-message",
    "allow-react-to-conversation-message",
    "allow-send-strong-reminder",
    "allow-show-strong-reminder",
    "allow-open-strong-reminder",
    "allow-dismiss-strong-reminder",
    "allow-send-conversation-file",
    "allow-retry-conversation-file",
    "allow-get-conversation-messages",
    "allow-mark-messages-read",
    "allow-search-workspace-messages",
    "allow-update-conversation-state",
    "allow-clear-conversation-history",
    "allow-get-file-center",
    "allow-get-transfers",
    "allow-cancel-transfer",
    "allow-update-device-metadata",
    "allow-delete-local-file",
    "allow-open-workspace-file",
    "allow-reveal-workspace-file",
    "allow-start-capture-editor",
    "allow-stage-image-attachment",
    "allow-discard-staged-attachment",
    "allow-read-workspace-media",
    "allow-refresh-local-ips",
    "allow-get-all-local-ips",
    "allow-set-local-ip",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "**" }
      ]
    }
  ]
}
