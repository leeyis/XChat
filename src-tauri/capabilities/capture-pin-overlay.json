{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-pin-overlay",
  "description": "Controls and annotation for the overlay's own pinned image",
  "windows": ["capture-menu-*", "capture-edit-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-scale-factor",
    "allow-get-pending-capture",
    "allow-ready-pinned-capture-overlay",
    "allow-close-pinned-capture-overlay",
    "allow-pin-capture",
    "allow-finish-capture-editor",
    "allow-save-capture-editor",
    "allow-copy-capture-editor",
    "allow-read-capture-clipboard",
    "allow-write-capture-text"
  ]
}
