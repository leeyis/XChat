{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-toolbar",
  "description": "Limited controls for the persistent remote sharing toolbar",
  "windows": ["remote-toolbar-*"],
  "permissions": [
    "core:window:allow-start-dragging", "core:window:allow-close",
    "core:window:allow-outer-position", "core:window:allow-scale-factor",
    "core:window:allow-set-size", "core:window:allow-set-position",
    "core:window:allow-current-monitor", "core:window:allow-available-monitors",
    "core:event:allow-listen", "core:event:allow-unlisten",
    "allow-remote-toolbar"
  ]
}
